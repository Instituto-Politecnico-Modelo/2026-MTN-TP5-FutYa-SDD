# ============================================================
# FútYa — Variables de entorno para Docker Compose
# ============================================================
# Copiá este archivo a .env y completá los valores reales.
# NUNCA commits el archivo .env al repositorio.
# ============================================================

# ── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=futbol5ya_db
MYSQL_USER=futya_user
MYSQL_PASSWORD=change_me_db_password

# ── JWT ──────────────────────────────────────────────────────
# Secret de al menos 32 caracteres aleatorios para firmar tokens.
# Generalo con: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret_minimum_32_chars_long
JWT_EXPIRATION_MS=86400000

# ── OpenWeatherMap ───────────────────────────────────────────
# API key obtenida en https://openweathermap.org/api
# La clave gratuita ("One Call API 3.0") es suficiente.
OPENWEATHER_API_KEY=change_me_openweather_api_key
# Coordenadas de Rosario, Argentina (modificar según la ciudad de la cancha)
OPENWEATHER_LAT=-32.9442
OPENWEATHER_LON=-60.6505

# ── Mercado Pago ─────────────────────────────────────────────
# Credenciales de https://www.mercadopago.com.ar/developers
# Usar credenciales de SANDBOX para pruebas.
MERCADOPAGO_ACCESS_TOKEN=change_me_mp_access_token
MERCADOPAGO_WEBHOOK_SECRET=change_me_mp_webhook_secret

# URLs de retorno tras el pago (deben ser públicas en producción)
# En desarrollo local, usar ngrok u otro túnel público para el webhook.
MERCADOPAGO_SUCCESS_URL=http://localhost:5173/pagos/success
MERCADOPAGO_FAILURE_URL=http://localhost:5173/pagos/failure
MERCADOPAGO_PENDING_URL=http://localhost:5173/pagos/pending
MERCADOPAGO_NOTIFICATION_URL=http://localhost:8081/api/pagos/webhook

# ── Reservas ─────────────────────────────────────────────────
# Minutos máximos para completar el pago antes de liberar el turno
RESERVA_PAGO_TIMEOUT_MINUTOS=15
